# Google AdSense (production)
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXX
# Optional manual display unit slot
NEXT_PUBLIC_ADSENSE_SLOT=

# Google Analytics 4 (production). Use a new property for the dedicated site.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX

# ---------------------------------------------------------------------------
# Supabase (Project Settings → API). Region recommendation: ap-southeast-2 (Sydney).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only; never expose to the browser. Used by webhooks / admin scripts.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Database URI for migrations via psql / Supabase CLI. Session pooler preferred (IPv4).
# Supabase → Project Settings → Database → Connection string → URI (Session mode).
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Public base URL (no trailing slash). Local: http://localhost:3000
APP_URL=http://localhost:3000
